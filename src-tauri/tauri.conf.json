{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SGameStudio",
  "version": "0.1.0",
  "identifier": "com.sgamestudio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SGameStudio",
        "width": 1600,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon_32x32.png",
      "icons/icon_128x128.png",
      "icons/icon_256x256.png"
    ]
  }
}