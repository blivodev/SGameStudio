# Generated by SGameStudio v1.0.0
# Entity: PixelKnight (2D Platformer Character Controller)
# Target Engine: Godot 4.x (GDScript)

extends CharacterBody2D

class_name KnightController

enum State { IDLE, RUN, SLASH, JUMP, FALL }

@export_group("Locomotion")
@export var move_speed: float = 220.0
@export var acceleration: float = 1200.0
@export var friction: float = 1400.0
@export var jump_velocity: float = -420.0
@export var coyote_time_duration: float = 0.12

@export_group("Combat")
@export var slash_duration: float = 0.35

@onready var animation_player: AnimationPlayer = $AnimationPlayer
@onready var sfx_step: AudioStreamPlayer2D = $Audio/SfxStep
@onready var sfx_slash: AudioStreamPlayer2D = $Audio/SfxSlash
@onready var vocal_grunt: AudioStreamPlayer2D = $Audio/VocalGrunt
@onready var collision_shape: CollisionShape2D = $CollisionShape2D

var current_state: State = State.IDLE
var current_gravity: float = ProjectSettings.get_setting("physics/2d/default_gravity")
var coyote_timer: float = 0.0
var slash_timer: float = 0.0

func _physics_process(delta: float) -> void:
	# 1. Update Timers
	if is_on_floor():
		coyote_timer = coyote_time_duration
	else:
		coyote_timer = max(0.0, coyote_timer - delta)

	if current_state == State.SLASH:
		slash_timer -= delta
		if slash_timer <= 0.0:
			transition_to(State.IDLE)

	# 2. Apply Gravity
	if not is_on_floor():
		velocity.y += current_gravity * delta

	# 3. Handle Inputs (When not locked in attack)
	if current_state != State.SLASH:
		handle_movement_input(delta)
		handle_jump_input()
		handle_attack_input()

	# 4. Execute Physics Step
	move_and_slide()

	# 5. Update Visuals
	update_animations()

func handle_movement_input(delta: float) -> void:
	var direction := Input.get_axis("ui_left", "ui_right")
	if direction != 0.0:
		velocity.x = move_toward(velocity.x, direction * move_speed, acceleration * delta)
		# Face direction
		$Visuals.scale.x = sign(direction)
	else:
		velocity.x = move_toward(velocity.x, 0.0, friction * delta)

func handle_jump_input() -> void:
	if Input.is_action_just_pressed("ui_accept") and coyote_timer > 0.0:
		velocity.y = jump_velocity
		coyote_timer = 0.0
		transition_to(State.JUMP)

func handle_attack_input() -> void:
	if Input.is_action_just_pressed("attack") and is_on_floor():
		velocity.x = 0.0 # Halt movement on slash
		slash_timer = slash_duration
		transition_to(State.SLASH)
		if sfx_slash:
			sfx_slash.play()
		if vocal_grunt and randf() > 0.4:
			vocal_grunt.play()

func transition_to(new_state: State) -> void:
	current_state = new_state

func update_animations() -> void:
	if not animation_player:
		return

	match current_state:
		State.SLASH:
			animation_player.play("Slash")
		State.JUMP:
			if velocity.y < 0:
				animation_player.play("Jump")
			else:
				animation_player.play("Fall")
		State.RUN:
			if abs(velocity.x) > 10.0:
				animation_player.play("Run")
			else:
				transition_to(State.IDLE)
		State.IDLE:
			if abs(velocity.x) > 10.0:
				transition_to(State.RUN)
			else:
				animation_player.play("Idle")
